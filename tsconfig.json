{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@forma/*": ["packages/*/src/index.ts"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "apps/web/src",
    "packages",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
