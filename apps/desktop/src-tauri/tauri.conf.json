{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VEXTRIO 3D",
  "version": "0.2.0-alpha.8",
  "identifier": "studio.forma.editor",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VEXTRIO 3D — 0.2.0 Alpha.8",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "publisher": "VEXTRIO 3D",
    "shortDescription": "VEXTRIO 3D — бесплатный 3D-редактор",
    "windows": {
      "nsis": {
        "template": "installer/compat.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer/rename-shortcuts.nsh"
      }
    }
  },
  "mainBinaryName": "forma-editor"
}
